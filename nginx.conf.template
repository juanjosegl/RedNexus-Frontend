# Plantilla: al arrancar, la imagen de Nginx reemplaza ${API_UPSTREAM} con la variable de entorno
# y genera /etc/nginx/conf.d/default.conf. Asi la misma imagen sirve en Docker y en Kubernetes.
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  # La API vive bajo /api; el navegador nunca necesita conocer la URL del backend
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Notas de voz
    client_max_body_size 10m;
  }

  # Vue Router en modo history: toda ruta desconocida vuelve a index.html
  location / {
    try_files $uri $uri/ /index.html;
  }
}
